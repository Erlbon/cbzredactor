__pycache__/
*.pyc
*.pyo
.pytest_cache/
build/
dist/
# Linux builds (redactor-build-tools/linux-build/build.sh)
build-linux/
dist-linux/
*.spec.bak
*.tmp_write

# Local settings (holds the user's own Comic Vine API key) -- never
# committed, same reasoning as any other per-machine credentials file.
cbzredactor_settings.ini

# Written next to the exe on an unhandled exception -- per-machine
# diagnostic output, not something to ship in the repo.
cbzredactor_crash.log

# Learned scanner credit pages (fingerprints + thumbnails) -- per-user data.
cbzredactor_credit_pages.json

# File > Undo Last Rename's log (redactor_common's RenameLog) -- per-user data,
# next to the settings like cbzredactor_settings.ini.
cbzredactor_rename_log.json
